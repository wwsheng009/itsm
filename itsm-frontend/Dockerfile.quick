# Quick image build from a locally built `dist/` (no Node toolchain needed).
#
# Usage:
#   npm run build   # produces itsm-frontend/dist (Vite)
#   docker build -f Dockerfile.quick -t itsm-frontend:local .
FROM nginx:alpine

# Static-only server config (SPA fallback, cache policy, /health, /uploads/).
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html

# Kept at 3000, matching nginx/conf.d/default.conf and the production image.
EXPOSE 3000

# Inherits nginx:alpine's default CMD ["nginx", "-g", "daemon off;"].
