# ITSM Backend Configuration Example
# Copy this file to config.yaml and adjust values for your environment.
# All values support ${ENV_VAR:default} syntax for environment variable substitution.

database:
  host: "${DB_HOST:localhost}"
  port: ${DB_PORT:5432}
  user: "${DB_USER:dev}"
  password: "${DB_PASSWORD:}"
  dbname: "${DB_NAME:itsm}"
  sslmode: "${DB_SSLMODE:disable}"
  # Optional: separate low-privilege role for application requests (bypasses RLS when empty)
  app_role_user: "${DB_APP_ROLE_USER:}"
  app_role_password: "${DB_APP_ROLE_PASSWORD:}"
  # Optional: superuser role for migrations and background jobs
  admin_role_user: "${DB_ADMIN_ROLE_USER:}"
  admin_role_password: "${DB_ADMIN_ROLE_PASSWORD:}"

server:
  port: ${SERVER_PORT:8080}
  mode: "${SERVER_MODE:release}"  # debug, release
  cookie_secure: false           # set true only behind HTTPS

jwt:
  secret: "${JWT_SECRET:}"        # auto-generated if empty (32-byte random)
  expire_time: ${JWT_EXPIRE_TIME:15}        # minutes
  refresh_expire_time: ${JWT_REFRESH_EXPIRE_TIME:604800}  # seconds (7 days)

log:
  level: "${LOG_LEVEL:info}"      # debug, info, warn, error
  path: "${LOG_PATH:./logs}"
  max_size: ${LOG_MAX_SIZE:100}   # MB per file
  max_backups: ${LOG_MAX_BACKUPS:7}
  max_age: ${LOG_MAX_AGE:30}      # days
  compress: true
  local_time: true
  development: ${LOG_DEVELOPMENT:false}
  slow_request_threshold: ${SLOW_REQUEST_THRESHOLD:1000}  # ms
  enable_stack_trace: true
  skip_health_check_logs: true

redis:
  host: "${REDIS_HOST:localhost}"
  port: ${REDIS_PORT:6379}
  password: "${REDIS_PASSWORD:}"
  db: ${REDIS_DB:0}

llm:
  # mock = E2E/本地联调用的确定性替身（M2-05）；需同时置 LLM_MOCK_ENABLED=true 才生效，
  # 未显式开启时即使 provider=mock 也会回退默认 provider（生产不会隐式启用替身）。
  provider: "${LLM_PROVIDER:openai}"   # openai, azure, local, mock
  model: "${LLM_MODEL:gpt-4o-mini}"
  api_key: "${LLM_API_KEY:}"
  endpoint: "${LLM_ENDPOINT:}"          # for azure or local providers
  token_cap: ${LLM_TOKEN_CAP:8000}     # per-request soft cap (~chars/4)
  protocol_adapter_enabled: ${LLM_PROTOCOL_ADAPTER_ENABLED:false}  # BE-9 protocol adapter switch (default off)

sms:
  provider: "${SMS_PROVIDER:}"          # aliyun, tencent, empty=disabled
  aliyun:
    access_key_id: "${ALIYUN_ACCESS_KEY_ID:}"
    access_key_secret: "${ALIYUN_ACCESS_KEY_SECRET:}"
    sign_name: "${ALIYUN_SMS_SIGN:}"
    endpoint: "${ALIYUN_SMS_ENDPOINT:}"
  tencent:
    secret_id: "${TENCENT_SECRET_ID:}"
    secret_key: "${TENCENT_SECRET_KEY:}"
    app_id: "${TENCENT_SMS_APP_ID:}"
    sign_name: "${TENCENT_SMS_SIGN:}"

smtp:
  enabled: ${SMTP_ENABLED:false}
  host: "${SMTP_HOST:}"
  port: ${SMTP_PORT:587}
  username: "${SMTP_USERNAME:}"
  password: "${SMTP_PASSWORD:}"
  from_email: "${SMTP_FROM_EMAIL:}"
  from_name: "${SMTP_FROM_NAME:ITSM}"
  encryption: "${SMTP_ENCRYPTION:tls}"  # tls, ssl, none
  skip_verify: false

ticket:
  default_response_hours: ${TICKET_DEFAULT_RESPONSE_HOURS:4}
  default_resolution_hours: ${TICKET_DEFAULT_RESOLUTION_HOURS:24}

deployment:
  mode: "${DEPLOYMENT_MODE:private}"  # private, saas, saas_msp
  auto_migrate: ${ITSM_AUTO_MIGRATE:true}
  auto_seed: ${ITSM_AUTO_SEED:true}

security:
  csrf_enabled: ${CSRF_ENABLED:false}

# RLS controls PostgreSQL Row-Level Security enforcement tiers.
# Default is "off" (zero risk — middleware still injects tenant_id into context).
rls:
  mode: "${RLS_MODE:off}"              # off, shadow, enforce
  tenant_var_name: "${RLS_TENANT_VAR_NAME:app.current_tenant}"

# 附件域灰度开关（方案 docs/plan/generic-attachment-richtext-control-plan.md §6.1）
# 全部默认 false = 保留现网旧链路、零行为变化；灰度/回退改本块（部署级）或租户级
# system_config 的 attachment 分组（键名相同，见 docs/install.md「3.1 附件域灰度开关」）。
attachment:
  generic_read_enabled: ${ATTACHMENT_GENERIC_READ_ENABLED:false}    # 通用读路径（A2/A3/A4/A6）；关闭回退旧表，URL 不变
  generic_write_enabled: ${ATTACHMENT_GENERIC_WRITE_ENABLED:false}  # 通用写入（A1/A5）；关闭回退旧工单写入路径
  dual_write_enabled: ${ATTACHMENT_DUAL_WRITE_ENABLED:false}        # 双写对账（P2）；关闭即停止双写，旧表为事实源
  inline_image_enabled: ${ATTACHMENT_INLINE_IMAGE_ENABLED:false}    # 富文本内嵌图片走通用链路；关闭即编辑器图片入口禁用
  # —— BE-8 生命周期清理（部署级，无租户级覆盖）——
  cleanup_enabled: ${ATTACHMENT_CLEANUP_ENABLED:false}              # 清理任务；关闭=不启动，软删记录与物理文件都不动
  cleanup_purge_enabled: ${ATTACHMENT_CLEANUP_PURGE_ENABLED:false}  # 落删开关；false=仅演练（dry-run 只统计不删除）
  retention_days: ${ATTACHMENT_RETENTION_DAYS:30}                   # 软删保留期（天），到期后回收物理文件
  cleanup_interval_minutes: ${ATTACHMENT_CLEANUP_INTERVAL_MINUTES:360}  # 轮询间隔（分钟）
  cleanup_batch_size: ${ATTACHMENT_CLEANUP_BATCH_SIZE:200}          # 单轮单租户处理上限（条，硬上限 1000）

# MCP 外部工具接入（方案 docs/plan/itsm-mcp-external-tool-integration-implementation-plan-2026-09-27.md M0-01）
# 默认关闭：不建连、不装配、工具面不含 MCP，对现有系统零行为变化。
mcp:
  enabled: ${MCP_ENABLED:false}                                 # 全局开关；关闭时零行为变化
  connect_timeout_seconds: ${MCP_CONNECT_TIMEOUT_SECONDS:10}    # 建立连接超时（秒）
  call_timeout_seconds: ${MCP_CALL_TIMEOUT_SECONDS:30}          # 单次 tools/call 超时（秒）
  test_timeout_seconds: ${MCP_TEST_TIMEOUT_SECONDS:10}          # 管理面「测试连接」同步超时（秒，上限 10）
  max_servers_per_tenant: ${MCP_MAX_SERVERS_PER_TENANT:20}      # 单租户服务器数量上限
  write_enabled: ${MCP_WRITE_ENABLED:false}                     # 写工具面（L1.5 回滚开关，M1-02）：开启后写工具可见，仍需 mcp:write + 人工审批
  # —— 工具面预算（M2-03，分析报告 §9.1）：超限发出 mcp.tools.budget_exceeded 事件 ——
  tools_budget: ${MCP_TOOLS_BUDGET:40}                          # 单租户有效工具数预算（>40 告警）
  tools_context_tokens: ${MCP_TOOLS_CONTEXT_TOKENS:128000}      # 占比判定使用的上下文预算（tokens）
  tools_token_share: ${MCP_TOOLS_TOKEN_SHARE:0.30}              # 工具面 token 占比上限（0-1，>30% 告警）
