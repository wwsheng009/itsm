# ITSM 环境配置
# ===========================================
# 开发环境：使用 trust 认证，无需设置密码
# 生产环境：请务必设置强密码！

# 数据库配置（必需）
DB_PASSWORD=

# JWT 密钥（必需）
JWT_SECRET=

# ===========================================
# 生产环境建议使用随机生成器创建密码，例如：
# JWT_SECRET=$(openssl rand -base64 32)
# DB_PASSWORD=$(openssl rand -base64 16)
# ===========================================

# ===========================================
# 变更管理（可选）
# ===========================================
# 标准变更低风险自动免审（默认 false，合规部署保持关闭）
# 开启后：标准变更 + 低风险 + 有实施/回滚计划 -> 直接 APPROVED，跳过审批
# 注意：风险等级由创建人自报，政务/医疗等强合规场景请勿开启
# ENABLE_STANDARD_CHANGE_AUTO_APPROVE=false

# ===========================================
# MCP 外部工具接入（默认开启：管理面/组件就绪；服务器与工具仍默认拒绝）
# ===========================================
# 全局开关；置 false 可彻底关闭（零装配、零路由、工具面不含 MCP）——回滚 L1
# MCP_ENABLED=false
# MCP_CONNECT_TIMEOUT_SECONDS=10    # 建立连接超时（秒）
# MCP_CALL_TIMEOUT_SECONDS=30       # 单次 tools/call 超时（秒）
# MCP_TEST_TIMEOUT_SECONDS=10       # 管理面「测试连接」同步超时（秒，上限 10）
# MCP_MAX_SERVERS_PER_TENANT=20     # 单租户服务器数量上限
# 出站安全（M0-05；默认严格 = 仅 https + 公网 + 443/80；生产必须保持 false/空）
# 本地联调 mock MCP（127.0.0.1:19090）时才放开下面三行：
# MCP_ALLOW_HTTP=true
# MCP_ALLOW_PRIVATE_NETWORKS=true
# MCP_ALLOWED_PORTS=19090

# ===========================================
# Bot 能力（B0–B4，可选，默认关闭）
# ===========================================
# 全局开关；关闭时零行为变化（不注册 /api/v1/admin/bots 与 /api/v1/ai/bot-metrics）
# BOT_ENABLED=false

# ===========================================
# 权限单源（IP-P1-2，可选，默认关闭）
# ===========================================
# 静态权限表回退开关。权限默认只从 user_tenant_memberships.role_id → role_permissions
# 计算；无 membership / role_id 为空时 fail-closed。仅 IP-P1-1 回填尚未覆盖的迁移窗口
# 可临时置 true（回退编译期 RolePermissions，且每次回退记 warn 日志）。
# AUTHZ_STATIC_FALLBACK=false
