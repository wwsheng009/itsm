# ============================================
# ITSM Production Environment Configuration
# ============================================
# 生成方式（推荐，自动填充随机密钥）：
#   ./scripts/deploy-prod.sh init
# 或：
#   make prod-init
#
# 不要先手动 cp 再执行 init：init 检测到 .env.prod 已存在会跳过，
# 导致随机密钥没有生成。请让 init 生成后再编辑本文件。
#
# SECURITY: Never commit .env.prod to version control.
# 标记 [REQUIRED] 的项必须在生产部署前显式设置。
# 标记 [COMPOSE-IGNORED] 的项在 docker-compose.prod.yml 中已被硬编码或
# 由容器内固定值覆盖；仅在裸机/自定义编排中生效，修改 Compose 部署不会生效。
# ============================================

# Immutable application/image version [REQUIRED]
# Production must use a tested release tag or immutable image version.
# Never use "latest"; the deploy script rejects "latest" and the placeholder.
VERSION=CHANGE_ME_RELEASE_TAG

# --------------------------------------------
# Database [REQUIRED]
# --------------------------------------------
DB_HOST=postgres             # [COMPOSE-IGNORED] Compose uses service name postgres
DB_PORT=5432                 # [COMPOSE-IGNORED]
DB_USER=itsm
DB_PASSWORD=                 # [REQUIRED] 32+ chars
DB_NAME=itsm_prod
DB_SSLMODE=disable           # Internal Compose DB only; use verify-full for external DB

# --------------------------------------------
# Redis [REQUIRED]
# --------------------------------------------
REDIS_HOST=redis             # [COMPOSE-IGNORED]
REDIS_PORT=6379              # [COMPOSE-IGNORED]
REDIS_PASSWORD=              # [REQUIRED] strong random value
REDIS_DB=0                   # [COMPOSE-IGNORED]

# --------------------------------------------
# JWT Authentication [REQUIRED]
# --------------------------------------------
JWT_SECRET=                  # [REQUIRED] 32+ chars; generate: openssl rand -base64 48
JWT_EXPIRE_TIME=86400        # [COMPOSE-IGNORED] compose sets 86400
JWT_REFRESH_EXPIRE_TIME=604800  # [COMPOSE-IGNORED] compose sets 604800

# --------------------------------------------
# System Config Secret Encryption [REQUIRED for SMTP credentials]
# --------------------------------------------
# Encrypts sensitive system_configs (e.g. smtpPassword) with AES-256-GCM.
# Generate: openssl rand -hex 32   (64 hex chars = 32 bytes)
# 生产缺失时保存敏感配置会 fail-closed；生成后不要随意变更，已有密文将无法解密。
CONFIG_SECRET_KEY=

# --------------------------------------------
# Admin Account [REQUIRED]
# --------------------------------------------
# 当前 docker-compose.prod.yml 的 itsm-init 走 legacy ADMIN_PASSWORD 首管路径。
# 一次性 bootstrap token 流程仍需独立 CLI/API 步骤，默认不在此 Compose 中启用。
ADMIN_PASSWORD=              # [REQUIRED] strong password; do not reuse test passwords

# --------------------------------------------
# Server / deployment
# --------------------------------------------
SERVER_PORT=8090             # [COMPOSE-IGNORED] backend config.yaml listens on 8090
PROD_HTTP_PORT=80             # 宿主入口端口（默认 80）；同机 80 被占用时改为 8088 等
SERVER_ENV=production        # [COMPOSE-IGNORED] compose sets production
GIN_MODE=release             # [COMPOSE-IGNORED]
BACKEND_DIAG_PORT=8090       # [COMPOSE-IGNORED] compose maps 127.0.0.1:8090:8090
DEPLOYMENT_MODE=saas         # private / saas / saas_msp
ITSM_AUTO_MIGRATE=false      # [COMPOSE-IGNORED] compose sets false
ITSM_AUTO_SEED=false         # [COMPOSE-IGNORED] compose sets false
ITSM_TENANT_GUARD_POLICY=fatal  # production default; keep fatal unless migration window
LOG_LEVEL=error              # [COMPOSE-IGNORED] compose sets error
LOG_FORMAT=json              # [COMPOSE-IGNORED] compose sets json
LOG_PATH=/app/logs           # [COMPOSE-IGNORED]

# Public base URL used by invitation links. If empty, the request Host header is
# used; set this explicitly for reverse-proxy / multi-domain deployments.
APP_BASE_URL=https://itsm.example.com

# --------------------------------------------
# MinIO Object Storage [OPTIONAL - not started by default]
# --------------------------------------------
# Backend/frontend currently do not use MinIO/S3. The service is under the
# "storage" profile and is NOT started by a normal deployment.
# To run it:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml --profile storage up -d minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=            # [OPTIONAL] only needed with --profile storage
MINIO_SECRET_KEY=            # [OPTIONAL] only needed with --profile storage
MINIO_BUCKET=itsm-uploads
MINIO_USE_SSL=false

# --------------------------------------------
# LLM / AI Features
# --------------------------------------------
# AI 默认启用；Provider 的权威配置在「系统配置 → LLM 模型」页面（DB 内
# llm_provider_configs，按租户生效）。下面的 LLM_* 是 sidecar/静态回退值，
# 不是多 Provider 模式下的实际 Provider 选择来源。
LLM_PROVIDER=openai          # openai/azure/local/minimax (static fallback)
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=                 # Optional: static fallback; prefer frontend provider config
LLM_ENDPOINT=                # Optional: custom OpenAI-compatible endpoint
LLM_TIMEOUT=                 # Optional: seconds; blank = provider default
OPENAI_API_KEY=              # Legacy fallback; prefer LLM_API_KEY or frontend config
OPENAI_BASE_URL=             # Optional: custom endpoint
LLM_MULTI_PROVIDER_ENABLED=true  # true = /ai/providers* + frontend provider selector
LLM_PROVIDER_ENCRYPTION_KEY= # [REQUIRED for DB providers] openssl rand -hex 32
ITSM_AI_READY=1              # 1 = show AI entry; 0 = hide AI entry on deployments without provider
# 可选：AI sidecar 健康度/观测开关（默认值见 itsm-backend/config.yaml）
# AI_TELEMETRY_RETENTION_DAYS=90
# AI_TELEMETRY_CLEANUP_INTERVAL_MINUTES=1440
# AI_TELEMETRY_CLEANUP_BATCH_SIZE=5000
# AI_HEALTH_SWEEPER_ENABLED=false
# AI_HEALTH_SWEEPER_INTERVAL_MINUTES=15
# AI_HEALTH_SWEEPER_WINDOW_DAYS=7

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
CORS_ALLOWED_ORIGINS=https://itsm.example.com

# --------------------------------------------
# Email Notifications (SMTP)
# --------------------------------------------
# SMTP_ENABLED 是总开关：只设置 SMTP_HOST 不会启用邮件。
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@itsm.example.com
SMTP_FROM=noreply@itsm.example.com   # legacy alias; SMTP_FROM_EMAIL wins
SMTP_FROM_NAME=ITSM System
SMTP_ENCRYPTION=tls                   # tls / ssl / none

# --------------------------------------------
# DingTalk / WeCom Notifications
# --------------------------------------------
DINGTALK_WEBHOOK=
WECOM_WEBHOOK=

# --------------------------------------------
# Personal Access Tokens (PAT)
# --------------------------------------------
# 默认与镜像内 config.yaml 一致为启用；生产首轮建议显式设为 false，
# 完成 PAT 验收后再开启。
PAT_ENABLED=true
PAT_DEFAULT_TTL_DAYS=90
PAT_MAX_TTL_DAYS=365
PAT_MAX_ACTIVE_PER_USER=20
PAT_USAGE_AUDIT_MODE=dedupe          # dedupe / all / off
PAT_USAGE_AUDIT_WINDOW_SECONDS=60
PAT_RATE_LIMIT_PER_MINUTE=120        # 0 = unlimited
PAT_HOUSEKEEPING_RETENTION_DAYS=180

# --------------------------------------------
# Bot / MCP runtime switches
# --------------------------------------------
# 默认关闭 Bot 与 MCP 写工具面；开启写面必须经过安全评审与前端授权。
BOT_ENABLED=false
BOT_REDACTION_PROFILE=default        # default / strict
BOT_BUDGET_MAX_STEPS=24
BOT_BUDGET_MAX_TOKENS=100000
BOT_BUDGET_MAX_TOOL_CALLS=12
BOT_BUDGET_TOOL_TIMEOUT_SECONDS=30
BOT_BUDGET_MAX_OUTPUT_BYTES=65536
BOT_CONFIRMATION_TTL_HOURS=24
MCP_ENABLED=true
MCP_WRITE_ENABLED=false
MCP_ALLOW_HTTP=false
MCP_ALLOW_PRIVATE_NETWORKS=false
MCP_ALLOWED_PORTS=443

# --------------------------------------------
# Attachment switches
# --------------------------------------------
# 与镜像内 config.yaml 的当前默认值对齐；如需回退旧链路，把对应项改为 false。
ATTACHMENT_MAX_FILE_SIZE_MB=10
ATTACHMENT_GENERIC_READ_ENABLED=true
ATTACHMENT_GENERIC_WRITE_ENABLED=true
ATTACHMENT_DUAL_WRITE_ENABLED=false
ATTACHMENT_INLINE_IMAGE_ENABLED=true
ATTACHMENT_CLEANUP_ENABLED=false
ATTACHMENT_CLEANUP_PURGE_ENABLED=false
ATTACHMENT_RETENTION_DAYS=30
ATTACHMENT_CLEANUP_INTERVAL_MINUTES=360
ATTACHMENT_CLEANUP_BATCH_SIZE=200

# --------------------------------------------
# Frontend (build-time values; changes require image rebuild)
# --------------------------------------------
# Keep empty for the standard Nginx deployment. API clients already use
# /api/v1/* paths, so setting this to /api would produce /api/api/v1/*.
VITE_API_URL=
VITE_API_VERSION=v1
VITE_API_TIMEOUT=30000
VITE_ENABLE_AI=true
ITSM_BACKEND_URL=http://itsm-backend:8090

# --------------------------------------------
# RLS (optional hardening)
# --------------------------------------------
# off    = no DB policies (current production default in compose)
# shadow = set tenant GUC + observe missing-context warnings only
# enforce= DB policies active; requires `rls-apply` and low-privilege DB roles
# Do NOT switch to enforce until cmd/rls-apply has been applied and G17 is fixed.
RLS_MODE=off
RLS_TENANT_VAR_NAME=app.current_tenant

# --------------------------------------------
# Monitoring (opt-in via "monitoring" profile)
# --------------------------------------------
# Enable with:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml --profile monitoring up -d
# When active:
#   1. Set METRICS_REQUIRE_AUTH=false so Prometheus can scrape /metrics.
#   2. Set GRAFANA_ADMIN_PASSWORD to a strong password (required).
# Ports are localhost-only: 9090 / 9093 / 3001.
METRICS_REQUIRE_AUTH=true
GRAFANA_ADMIN_PASSWORD=          # 生成随机值；monitoring profile 启用时用于 Grafana 登录

# --------------------------------------------
# TLS
# --------------------------------------------
# This Compose stack exposes HTTP on port 80 for an enterprise ingress/load
# balancer. TLS must terminate at that trusted ingress; do not expose port 80
# directly to untrusted networks.
