# ITSM 演示环境变量模板（复制为 .env.demo 后按环境填写；.env.demo 不入库）
#
# 生成建议（在服务器仓库根目录执行，避免把主站密钥打印到终端）：
#   {
#     echo "VERSION=1.8.0-dev.a29ad103"
#     grep -E '^(DB_USER|DB_PASSWORD|DEPLOYMENT_MODE|RLS_MODE)=' .env.prod
#     grep -E '^REDIS_PASSWORD=' .env.prod
#     echo "DEMO_DB_NAME=itsm_demo"
#     echo "DEMO_HTTP_PORT=8089"
#     echo "DEMO_JWT_SECRET=$(openssl rand -hex 32)"
#     echo "DEMO_CONFIG_SECRET_KEY=$(openssl rand -hex 32)"
#     echo "DEMO_ADMIN_PASSWORD=<演示平台管理员口令，需公开给演示用户>"
#     grep -E '^(LLM_PROVIDER|LLM_MODEL|LLM_API_KEY|LLM_ENDPOINT|OPENAI_API_KEY|OPENAI_BASE_URL|LLM_MULTI_PROVIDER_ENABLED|LLM_PROVIDER_ENCRYPTION_KEY)=' .env.prod || true
#   } > .env.demo && chmod 600 .env.demo

# 镜像版本（与主站同一镜像；演示栈不单独构建）
VERSION=1.8.0-dev.a29ad103

# 数据库：复用主站 postgres 实例，库名独立
DB_USER=itsm
DB_PASSWORD=__copy_from_env_prod__
DEMO_DB_NAME=itsm_demo
DB_SSLMODE=disable

# 演示栈专用 Redis 口令（可与主站相同，容器相互隔离）
REDIS_PASSWORD=__copy_from_env_prod__

# 演示栈 JWT 密钥（独立于主站；一旦生成勿随意变更）
DEMO_JWT_SECRET=__openssl_rand_hex_32__

# 演示栈系统配置凭据加密密钥（SCD4；独立于主站；用于加密 smtpPassword 等敏感配置，勿随意变更）
# 注意：SERVER_ENV=production 时缺失该键将拒绝保存敏感配置（fail-closed）。
DEMO_CONFIG_SECRET_KEY=__openssl_rand_hex_32__

# 演示平台管理员（admin）口令：用于平台侧开租户/建号/演示
DEMO_ADMIN_PASSWORD=__set_demo_admin_password__

# --------------------------------------------
# 个人访问令牌（PAT）— docs/plan/personal-access-token-plan-2026-10-16.md §3.12
# 演示栈首轮建议关闭，端到端验收通过后再开启（灰度口径见实施文档 §5）。
# --------------------------------------------
PAT_ENABLED=false
PAT_DEFAULT_TTL_DAYS=90
PAT_MAX_TTL_DAYS=365
PAT_MAX_ACTIVE_PER_USER=20
PAT_USAGE_AUDIT_MODE=dedupe
PAT_RATE_LIMIT_PER_MINUTE=120

# 演示入口端口
DEMO_HTTP_PORT=8089

# 部署模式：演示保持 saas_msp（MSP 跨租户能力可见）
DEPLOYMENT_MODE=saas_msp
RLS_MODE=shadow

# 主站网络（用于访问 itsm-postgres-prod；默认即可）
# DEMO_SHARED_NETWORK=itsm-prod_itsm-prod-network

# LLM（可选；留空则 AI 能力自动降级，不影响演示主链路）
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=
LLM_ENDPOINT=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MULTI_PROVIDER_ENABLED=true
LLM_PROVIDER_ENCRYPTION_KEY=
